# Copy to .env and fill in. NEVER commit .env.

# ---- Django -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Your domain(s), comma separated:
DJANGO_ALLOWED_HOSTS=api.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.org
# Leave false in production. true = local development only.
DJANGO_DEBUG=false
# Number of reverse proxies in front (Caddy/nginx = 1) so rate limits see the real IP.
NUM_PROXIES=1

# ---- Database (PostgreSQL) --------------------------------------------------
POSTGRES_DB=salama
POSTGRES_USER=salama
POSTGRES_PASSWORD=
# docker compose sets POSTGRES_HOST=db for you. Outside Docker:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---- Encryption of survivors' text at rest ----------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP SEPARATELY. If you lose it, encrypted fields cannot be read.
# To rotate: put the NEW key first, keep the old one after a comma.
FIELD_ENCRYPTION_KEYS=

# ---- Mobile app -------------------------------------------------------------
# Optional. Must equal --dart-define=SURVIVOR_API_KEY=... in the Flutter build.
# Not a secret (it ships inside the app); only keeps casual bots away.
SURVIVOR_API_KEY=

# ---- Africa's Talking -------------------------------------------------------
# Incoming SMS callback URL to give Africa's Talking:
#   https://api.example.org/api/sms/africastalking/?token=<AT_WEBHOOK_TOKEN>
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AT_WEBHOOK_TOKEN=
# Optional: SMS the CHWs when an SOS arrives (message contains no personal data).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
NOTIFY_CHWS_ON_SOS=false

# ---- Tuning (optional) ------------------------------------------------------
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7
# THROTTLE_INTAKE=300/hour
# THROTTLE_LOGIN=20/min
